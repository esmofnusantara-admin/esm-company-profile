generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// AUTH
// =====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(CONTENT_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  CONTENT_ADMIN
  FINANCE_ADMIN
}

// =====================
// CONTENT (BILINGUAL ID & EN)
// =====================

model Article {
  id          String          @id @default(cuid())
  title       String
  titleEn     String?         // Versi Bahasa Inggris
  slug        String          @unique
  excerpt     String          @db.Text
  excerptEn   String?         @db.Text // Versi Bahasa Inggris
  content     String          @db.Text
  contentEn   String?         @db.Text // Versi Bahasa Inggris
  coverImage  String?
  category    ArticleCategory
  status      PublishStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@map("articles")
}

enum ArticleCategory {
  DEVOTIONAL
  BERITA
  KESAKSIAN
  REFLEKSI
  MISI
  LAINNYA
}

model Bulletin {
  id          String        @id @default(cuid())
  title       String
  titleEn     String?
  description String?       @db.Text
  fileUrl     String
  edition     String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("bulletins")
}

model Event {
  id              String        @id @default(cuid())
  title           String
  titleEn         String?       // Versi Bahasa Inggris
  slug            String        @unique
  description     String        @db.Text
  descriptionEn   String?       @db.Text // Versi Bahasa Inggris
  coverImage      String?
  community       Community?
  location        String?
  locationEn      String?       // Versi Bahasa Inggris
  locationUrl     String?
  startDate       DateTime
  endDate         DateTime?
  status          PublishStatus @default(DRAFT)
  isCollaboration Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([startDate])
  @@index([community])
  @@map("events")
}

enum Community {
  EXPLORE
  ENCOUNTER
  CONNECT
  ALL
  LEADERSHIP
  STAFF
  ADVISORY
}

model TeamMember {
  id        String    @id @default(cuid())
  name      String
  role      String
  roleEn    String?
  community Community @default(ALL)
  photo     String?
  bio       String?   @db.Text
  bioEn     String?   @db.Text
  whatsapp  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("team_members")
}

model Testimony {
  id        String     @id @default(cuid())
  name      String
  role      String?
  quote     String     @db.Text
  quoteEn   String?    @db.Text // Versi Bahasa Inggris
  photo     String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("testimonies")
}

model FAQ {
  id         String   @id @default(cuid())
  question   String
  questionEn String?  // Versi Bahasa Inggris
  answer     String   @db.Text
  answerEn   String?  @db.Text // Versi Bahasa Inggris
  page       FAQPage  @default(GENERAL)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("faqs")
}

enum FAQPage {
  GENERAL
  KEMITRAAN
  PELAYANAN
}

// =====================
// MEDIA & DOKUMENTASI (FOTO & VIDEO)
// =====================

model MediaItem {
  id          String    @id @default(cuid())
  title       String
  titleEn     String?
  type        MediaType @default(IMAGE)
  url         String    @db.Text // Local path or external/YouTube URL
  thumbnail   String?   @db.Text
  category    String    @default("GENERAL") // BERANDA, BANTEN, TERNATE, RETREAT, CAMP, EXPLORE, ENCOUNTER, CONNECT
  description String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("media_items")
}

enum MediaType {
  IMAGE
  VIDEO
}

// =====================
// POKOK DOA BULANAN
// =====================

model PrayerRequest {
  id            String   @id @default(cuid())
  month         String   // e.g. "November 2026"
  title         String
  titleEn       String?
  description   String   @db.Text
  descriptionEn String?  @db.Text
  category      String   @default("MISI") // MISI, PELAYANAN, GENERASI, KEBUTUHAN
  isAnswered    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("prayer_requests")
}

// =====================
// KEMITRAAN & KEUANGAN
// =====================

model DonationRecord {
  id            String         @id @default(cuid())
  donorName     String?
  donorEmail    String?
  donorPhone    String?
  amount        Decimal        @db.Decimal(15, 2)
  type          DonationType
  message       String?        @db.Text
  status        DonationStatus @default(PENDING)
  transferProof String?
  confirmedAt   DateTime?
  confirmedBy   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("donation_records")
}

enum DonationType {
  SEKALI_BERI
  MITRA_BULANAN
}

enum DonationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model FinancialTransaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  description String
  category    String?
  date        DateTime        @default(now())
  recordedBy  String
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, date])
  @@map("financial_transactions")
}

enum TransactionType {
  PEMASUKAN
  PENGELUARAN
}

// =====================
// SITE CONFIG
// =====================

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
