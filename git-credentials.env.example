# ===================================================================
# GITHUB CREDENTIAL CONFIGURATION
# File ini digunakan untuk berganti akun GitHub (yusufrajatamba / esmofnusantara-admin)
# ===================================================================

# Ganti dengan username GitHub yang ingin digunakan
GITHUB_USERNAME=esmofnusantara-admin

# Ganti dengan Personal Access Token (PAT) dari GitHub
# Cara buat PAT: GitHub -> Settings -> Developer Settings -> Personal Access Tokens -> Tokens (classic) -> centang 'repo'
GITHUB_TOKEN=ghp_masukkan_token_github_disini
