# ===================================================================
# POSTGRESQL DOCKER INFRASTRUCTURE CONFIGURATION
# ===================================================================
POSTGRES_USER=esm_user
POSTGRES_PASSWORD=esm_password
POSTGRES_DB=esm_db
POSTGRES_PORT=5433

# Database URL for Host Development (connects to esm_postgres container on port 5433)
DATABASE_URL="postgresql://esm_user:esm_password@localhost:5433/esm_db?schema=public"

# ===================================================================
# AUTHENTICATION & PORTAL CREDENTIALS
# Default Super Admin: admin@esm.or.id / Admin@ESM2025!
# ===================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="esm-production-secret-key-must-be-at-least-32-chars-long"

# ===================================================================
# APPLICATION SETTINGS
# ===================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="id"
